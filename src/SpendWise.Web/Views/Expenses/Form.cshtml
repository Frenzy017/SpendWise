@model ExpenseFormViewModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Edit expense" : "Add expense";
}
<div class="card shadow-sm mx-auto form-card">
    <div class="card-body p-4">
        <h1 class="h4 mb-4">@ViewData["Title"]</h1>
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="Amount" class="form-label">Amount (€)</label>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" autofocus />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" type="date" asp-format="{0:yyyy-MM-dd}" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Choose a category…</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Note <span class="text-muted">(optional)</span></label>
                    <input asp-for="Description" class="form-control" placeholder="e.g. Pizza with friends" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Add expense")</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
